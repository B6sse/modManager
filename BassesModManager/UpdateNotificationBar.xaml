<UserControl x:Class="BassesModManager.UpdateNotificationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <UserControl.Resources>
        <!-- Purple button with hover sound (PurpleButtonStyle in MainWindow/GameSelectionWindow
             isn't visible here since UserControls resolve StaticResource within their own XAML) -->
        <Style x:Key="PurpleButtonStyle" BasedOn="{StaticResource PurpleButtonStyleBase}" TargetType="Button">
            <EventSetter Event="MouseEnter" Handler="PlayHoverSound"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#151515" BorderBrush="#8000FF" BorderThickness="2" CornerRadius="6" Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="MessageText"
                       Grid.Column="0"
                       Text="A new update is ready."
                       Foreground="White" FontSize="13"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,12,0"/>

            <Button Grid.Column="1" x:Name="UpdateNowButton" Content="UPDATE NOW"
                    Padding="12,5" Margin="0,0,8,0"
                    Style="{StaticResource PurpleButtonStyle}"
                    ToolTip="Installs the update and reopens the app automatically"
                    Click="UpdateNowButton_Click"/>

            <Button Grid.Column="2" x:Name="LaterButton" Content="LATER"
                    Padding="10,5"
                    Style="{StaticResource PurpleButtonStyle}"
                    ToolTip="Keep using this version for now"
                    Click="LaterButton_Click"/>
        </Grid>
    </Border>
</UserControl>
