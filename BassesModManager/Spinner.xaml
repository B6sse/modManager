<UserControl x:Class="BassesModManager.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A three-quarter ring turning once a second: the busy indicator next to a status
         line. Drawn to fit whatever Width/Height the user sets (Stretch=Uniform), in the
         same off-white as the text it sits beside. The rotation runs for as long as the
         control is loaded; hidden by collapsing it, as the two users do. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="Rotation" Angle="0"/>
            </Canvas.RenderTransform>
            <Canvas.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Rotation"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:1"
                                             RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Canvas.Triggers>
            <!-- Arc from the top, clockwise, three quarters round; stroke width 5 on a 30
                 unit diameter leaves room for the round caps inside the 40 unit canvas -->
            <Path Stroke="#F7F7F7" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 20,5 A 15,15 0 1 1 5,20"/>
        </Canvas>
    </Viewbox>
</UserControl>
