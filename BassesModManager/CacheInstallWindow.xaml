<Window x:Class="BassesModManager.CacheInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BassesModManager"
        Title="Installing cache..."
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        Loaded="Window_Loaded">
    <!-- Centred on the screen rather than on an owner: MainWindow is minimized out of the
         way before this opens, and an owned window would have gone down with it. -->
    <local:ProgressPanel x:Name="Progress"
                         HintText="This takes a few seconds. Please wait."/>
</Window>
