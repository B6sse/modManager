<UserControl x:Class="BassesModManager.CustomCursorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             Focusable="False"
             SnapsToDevicePixels="True">
    <!-- The real OS cursor is hidden app-wide (Mouse.OverrideCursor, set once in
         App.xaml.cs) - this Image is the only cursor the user ever sees, drawn on
         top of every window's content and moved to follow the mouse. -->
    <Image x:Name="CursorImage"
           Stretch="None"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           RenderTransformOrigin="0,0"
           Visibility="Collapsed">
        <Image.RenderTransform>
            <TranslateTransform x:Name="CursorPosition"/>
        </Image.RenderTransform>
    </Image>
</UserControl>
