  <ItemGroup>
    <!-- Auric, the in-game half. A copy of Kyber.dll from the Auric repo's public build
         (C:\Auric\Auric2, out\build\x64-Release, or the "Auric-dll" CI artifact), always
         the public variant: the developer build has console commands a host could use
         against players, and CI refuses it. GameFolder.InstallAuric places it in the
         game folder as version.dll, a static import the game loads at process start, so
         Auric is in the game from the first instruction and nothing is injected later.
         It also takes over what Frosty's CryptBase.dll shim did (the toc signature
         check), so that shim is no longer shipped. Update with Auric\update-auric.ps1. -->
    <Content Include="Auric\version.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Banners\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
