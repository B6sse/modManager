<Window x:Class="BassesModManager.GameSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BassesModManager.Converters"
        xmlns:local="clr-namespace:BassesModManager"
        Title="Axon" Height="520" Width="832" MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        FontSize="15">
    <Grid>
    <Grid Margin="20">
        <Grid.Resources>
            <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#222"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: title + settings -->
            <RowDefinition Height="*"/>     <!-- 2: game list (0 or 1 entries) -->
            <RowDefinition Height="Auto"/>  <!-- 3: buttons + version label -->
            <RowDefinition Height="Auto"/>  <!-- 4: double-click hint -->
            <RowDefinition Height="Auto"/>  <!-- 5: update notification bar -->
        </Grid.RowDefinitions>

        <!-- Settings -->
        <Button Grid.Row="0" x:Name="SettingsButton"
                 Padding="8,0" Height="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="SettingsButton_Click"
                Style="{StaticResource PurpleButtonStyle}"
                ToolTip="Settings">
            <Viewbox Width="21" Height="21">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource GearIcon}"
                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                </Canvas>
            </Viewbox>
        </Button>

        <TextBlock Grid.Row="0"
                   Text="STAR WARS BATTLEFRONT GAME PATH"
                   Style="{StaticResource HeadingTextStyle}"
                   FontSize="22"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

        <!-- Only ever 0 or 1 entries (this app supports one game), but kept as the same
             list-row look/feel Frosty users already know - hover highlight, click to
             select, double-click to continue. -->
        <Border Grid.Row="1" CornerRadius="3" BorderThickness="0" Padding="0" Margin="0,15,0,0" Background="Transparent">
            <ListView x:Name="GameList" Foreground="White" Background="Transparent" BorderThickness="0" Padding="0"
                      MouseDoubleClick="GameList_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="itemBorder" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="14,12" Margin="0"
                                            HorizontalAlignment="Stretch" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Left"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="#8000FF"/>
                                            <Setter TargetName="itemBorder" Property="Background" Value="#8000FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="#8000FF"/>
                                            <Setter TargetName="itemBorder" Property="Background" Value="#8000FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseEnter" Handler="PlayHoverSound"/>
                        <EventSetter Event="PreviewMouseDown" Handler="GameList_PreviewMouseDown"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="60" Height="60" CornerRadius="5" Margin="0,0,16,0" ClipToBounds="True">
                                <Image Source="{Binding BannerPath, Converter={StaticResource StringToImageSourceConverter}}"
                                       Stretch="UniformToFill" Width="60" Height="60"/>
                            </Border>
                            <TextBlock Text="{Binding Path}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Empty state: shown instead of the list whenever no valid Battlefront
             install is configured - re-evaluated every LoadSavedGame() call, so it
             comes back if the saved path stops being valid (e.g. settings cleared). -->
        <TextBlock x:Name="EmptyStateText" Grid.Row="1"
                   Text="Click LOCATE BATTLEFRONT below and select your Star Wars Battlefront game executable to get started."
                   Foreground="#888" FontSize="15" TextWrapping="Wrap"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="0,15,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="LocateButton" Content="LOCATE BATTLEFRONT" Margin="0,0,12,0"
                    Style="{StaticResource PurpleButtonStyle}"
                    ToolTip="Browse for starwarsbattlefront.exe"
                    Click="LocateButton_Click"/>
            <Button x:Name="SelectButton" Content="SELECT"
                    MinWidth="90"
                    Style="{StaticResource PurpleButtonStyle}"
                    IsEnabled="False"
                    ToolTip="Open mod selection for this game"
                    Click="SelectButton_Click"/>
        </StackPanel>

        <!-- Version label -->
        <TextBlock Grid.Row="2"
                   Text="v1.6"
                   FontSize="14"
                   Foreground="White"
                   FontWeight="Bold"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="0,10,0,0"/>

        <!-- Double-click hint - only relevant once there's actually a row to double-click -->
        <TextBlock x:Name="DoubleClickHintText" Grid.Row="3"
                   Text="Tip: double-click the game to jump straight to mod selection"
                   Foreground="#888"
                   FontSize="12"
                   HorizontalAlignment="Left"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <!-- Update ready notification (hidden until UpdateService has a verified download) -->
        <local:UpdateNotificationBar Grid.Row="4" Margin="0,10,0,0"/>
    </Grid>
    <local:CustomCursorOverlay/>
    </Grid>
</Window>
