<UserControl x:Class="BassesModManager.SettingToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Two named choices, both on screen at once. This is the shape the mode switch
             needs: EA SERVERS and AURIC are not on and off, and neither of them can be
             left to be inferred from the position of a knob. -->
        <ControlTemplate x:Key="LabelledTemplate" TargetType="CheckBox">
            <!-- "thumb" floats inside the track with a fixed margin on every side -
                 it never touches the track's edge or the column seam, so there is no
                 shared edge for two different CornerRadius values to disagree about
                 and leave a gap. Hover only ever changes a flat Background color, no
                 border geometry involved at all. -->
            <Border x:Name="track" CornerRadius="5" Height="34" Background="#2A2A2A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="thumb" Grid.Column="0" CornerRadius="5" Margin="3" Background="#8000FF"/>
                    <!-- Labels come from the control's OnLabel/OffLabel properties so the
                         same switch can read ON/OFF on the settings page and NORMAL/AURIC
                         on the main window. They live in the template's own namescope, so
                         a binding is the only way to reach them - the x:Name'd TextBlocks
                         are not fields on the code-behind. -->
                    <TextBlock x:Name="onLabel" Grid.Column="0" Foreground="#888888" FontWeight="Bold" FontSize="13"
                               Text="{Binding OnLabel, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                               Padding="18,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="offLabel" Grid.Column="1" Foreground="#888888" FontWeight="Bold" FontSize="13"
                               Text="{Binding OffLabel, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                               Padding="18,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="thumb" Property="Grid.Column" Value="0"/>
                    <Setter TargetName="onLabel" Property="Foreground" Value="White"/>
                    <Setter TargetName="offLabel" Property="Foreground" Value="#888888"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter TargetName="thumb" Property="Grid.Column" Value="1"/>
                    <Setter TargetName="onLabel" Property="Foreground" Value="#888888"/>
                    <Setter TargetName="offLabel" Property="Foreground" Value="White"/>
                </Trigger>
                <!-- Whole-control hover: track background brightens slightly - no
                     border, so nothing that can misalign. Kept close to the resting
                     #2A2A2A; brighter than this reads as the switch being active
                     rather than merely hovered. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="track" Property="Background" Value="#383838"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Plain on and off, with no word for either. A row of these down the mod list is
             what the labelled shape was too wide for: two words is a lot of room to spend
             saying something the position of a knob already says. Nothing is inferred from
             position alone though - the track changes colour as well, so the state is
             readable from either signal on its own.
             Same 5px corners and same 3px inset as the labelled shape above and as the
             variant segments in the mod list, so a smaller switch is all this is - not a
             differently drawn one. How tall it ends up is the caller's to say: the mod list
             keeps it under its row height, since a control with nothing written on it
             carried more weight than the mod name beside it, while the settings page gives
             it the full row so it lines up with the buttons in the same column. -->
        <ControlTemplate x:Key="CompactTemplate" TargetType="CheckBox">
            <!-- Every measurement comes from CompactHeight, so the shape keeps its
                 proportions at whatever height the caller asks for. The knob's side to side
                 movement is the one part not handled here - see PlaceKnob. -->
            <Border x:Name="track" CornerRadius="5"
                    Width="{Binding CompactWidth, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    Height="{Binding CompactHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    Background="#2A2A2A"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border x:Name="knob" CornerRadius="5" Margin="3"
                        Width="{Binding KnobSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Height="{Binding KnobSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Background="#888888"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="track" Property="Background" Value="#8000FF"/>
                    <Setter TargetName="knob" Property="Background" Value="White"/>
                </Trigger>
                <!-- Hover has to know which state it is brightening, so these come after
                     the IsChecked trigger and are matched on both properties at once. A
                     single IsMouseOver setter would have painted the on state grey. -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="False"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="track" Property="Background" Value="#383838"/>
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="track" Property="Background" Value="#9B33FF"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <!-- One CheckBox, not two RadioButtons: the whole switch is a single hover/click
         target (hovering over "ON" or "OFF" feels identical, clicking either side
         toggles). -->
    <CheckBox x:Name="ToggleCheckBox"
              MouseEnter="ToggleCheckBox_MouseEnter"
              Click="ToggleCheckBox_Click">
        <CheckBox.Style>
            <Style TargetType="CheckBox">
                <Setter Property="Template" Value="{StaticResource LabelledTemplate}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                        <Setter Property="Template" Value="{StaticResource CompactTemplate}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </CheckBox.Style>
    </CheckBox>
</UserControl>
