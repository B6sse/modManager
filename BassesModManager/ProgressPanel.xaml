<UserControl x:Class="BassesModManager.ProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
             xmlns:local="clr-namespace:BassesModManager"
             Width="550">
    <!-- Everything inside the two progress windows: building the cache on first run, and
         applying mods on launch. They show the same thing and used to be two copies of
         this markup, kept in step by hand.
         Only the width is fixed. The height is left to the content, so the cache window
         stays as short as what it actually shows rather than being padded out to leave
         room for a cancel button it does not have. -->
    <Border Background="Black" BorderBrush="#8000FF" BorderThickness="2" CornerRadius="8">
        <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>   <!-- 0: banner -->
                <RowDefinition Height="Auto"/>  <!-- 1: what is happening right now -->
                <RowDefinition Height="40"/>    <!-- 2: spinner or progress bar -->
                <RowDefinition Height="Auto"/>  <!-- 3: hint -->
                <RowDefinition Height="Auto"/>  <!-- 4: cancel, when there is one -->
            </Grid.RowDefinitions>

            <Image x:Name="BannerImage" Grid.Row="0" Stretch="Uniform" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" x:Name="StatusText" Text="Preparing..." Foreground="White" FontSize="14" Margin="0,0,0,10"/>

            <!-- Read phase: spinner. Write phase: progress bar. SmoothProgressLogger swaps them -->
            <Grid Grid.Row="2" Margin="0,0,0,5">
                <StackPanel x:Name="SpinnerPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                    <ctrl:FrostySpinner Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Loading data..." Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                             Style="{StaticResource PurpleProgressBarStyle}" Visibility="Collapsed"/>
            </Grid>

            <TextBlock Grid.Row="3" x:Name="HintTextBlock"
                       Foreground="#888" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <!-- Collapsed rather than hidden, so the row it sits in takes no height at
                 all for the window that has no use for it -->
            <Button Grid.Row="4" x:Name="CancelButton" Content="CANCEL"
                    HorizontalAlignment="Right" Margin="0,15,0,0" Padding="14,6"
                    Visibility="Collapsed"
                    Style="{StaticResource PurpleButtonStyle}"
                    Click="CancelButton_Click"/>
        </Grid>
        <local:CustomCursorOverlay/>
        </Grid>
    </Border>
</UserControl>
