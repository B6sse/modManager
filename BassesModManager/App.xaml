<Application x:Class="BassesModManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Normal body text -->
            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <!-- Heading text -->
            <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <!-- Gear for the settings button in each window. Geometry is a Freezable, not a
                 visual, so one resource can back several Paths - which is why the button
                 itself is plain inline XAML per window instead of its own UserControl. -->
