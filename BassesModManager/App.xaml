                                   l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41
                                   h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87
                                   C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58
                                   c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54
                                   c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96
                                   c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z
                                   M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>

            <!-- Progress bar for the cache install and launch windows. Lives here rather
                 than in either window so the two cannot drift apart.
                 The default WPF template has no way to round its corners, hence the
                 replacement: an outer Border for the track and PART_Indicator for the
                 fill, which the ProgressBar itself sizes. Keep CornerRadius at half the
                 Height for fully rounded ends. -->
            <Style x:Key="PurpleProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="10"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#8000FF"/>
                <Setter Property="Background" Value="#333"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <Grid>
                                    <!-- PART_Track spans the full width and is what the
                                         indicator's width is measured against -->
                                    <Rectangle x:Name="PART_Track"/>
                                    <Border x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="5"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Volume slider. Same shapes and colours as the progress bar: a dark rounded
                 track with a purple filled portion, plus a round purple knob.
                 Snapped to 25% steps rather than continuous - the whole range is only
                 0 to 0.4 on MediaPlayer's scale, so finer resolution would be resolution
                 nobody can hear, and snapping makes silence an exact, easily hit position
                 instead of something you have to nudge onto. -->
            <Style x:Key="PurpleSliderStyle" TargetType="Slider">
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="TickFrequency" Value="25"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                <Setter Property="SmallChange" Value="25"/>
                <Setter Property="LargeChange" Value="25"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6" CornerRadius="3" Background="#333" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track">
                                    <!-- The filled part to the left of the knob -->
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Focusable="False" IsTabStop="False" OverridesDefaultStyle="True">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" CornerRadius="3" Background="#8000FF" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <!-- Transparent so the dark track behind shows through -->
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Focusable="False" IsTabStop="False" OverridesDefaultStyle="True">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="16" Focusable="False" OverridesDefaultStyle="True"
                                               MouseEnter="SliderThumb_PlayHoverSound">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse x:Name="knob" Fill="#8000FF"/>
                                                    <ControlTemplate.Triggers>
                                                        <!-- Same inversion the buttons use on hover -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="knob" Property="Fill" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="knob" Property="Fill" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Button style (base; windows add EventSetter for hover sound) -->
            <Style x:Key="PurpleButtonStyleBase" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="#8000FF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#8000FF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#8000FF"/>
                        <Setter Property="BorderBrush" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#333"/>
                        <Setter Property="Foreground" Value="#666"/>
                        <Setter Property="BorderBrush" Value="#444"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Purple button with hover/click sounds. Use this one for buttons; the Base
                 style above is only for cases that need styling without the sounds.
                 The click sound is on the tunnelling press, not on Click. Two reasons, and
                 the first is a correctness one: handlers on a routed event run in the order
                 they were registered, and a style's EventSetter is registered when the
                 Style attribute is set - so whether the sound came before or after a
                 button's own handler depended on which attribute the markup happened to
                 list first. LAUNCH GAME listed Click first and went silent until all its
                 checks had finished. A preview event runs ahead of every bubbling handler
                 whatever the order. The second is that a press is when the user expects to
                 hear it, rather than on release. -->
            <Style x:Key="PurpleButtonStyle" BasedOn="{StaticResource PurpleButtonStyleBase}" TargetType="Button">
                <EventSetter Event="MouseEnter" Handler="Button_PlayHoverSound"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Button_PlayClickSound"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>