            <!-- Button style (base; windows add EventSetter for hover sound) -->
            <Style x:Key="PurpleButtonStyleBase" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="#8000FF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#8000FF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#8000FF"/>
                        <Setter Property="BorderBrush" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#333"/>
                        <Setter Property="Foreground" Value="#666"/>
                        <Setter Property="BorderBrush" Value="#444"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Purple button with hover/click sounds. Use this one for buttons; the Base
                 style above is only for cases that need styling without the sounds. -->
            <Style x:Key="PurpleButtonStyle" BasedOn="{StaticResource PurpleButtonStyleBase}" TargetType="Button">
                <EventSetter Event="MouseEnter" Handler="Button_PlayHoverSound"/>
                <EventSetter Event="Click" Handler="Button_PlayClickSound"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>