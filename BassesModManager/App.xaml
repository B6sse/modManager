<Application x:Class="BassesModManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>


            <!-- Normal body text -->
            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <!-- Heading text -->
            <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <!-- Volume slider: a dark rounded
                 track with a purple filled portion, plus a round purple knob.
                 Snapped to 25% steps rather than continuous - the whole range is only
                 0 to 0.4 on MediaPlayer's scale, so finer resolution would be resolution
                 nobody can hear, and snapping makes silence an exact, easily hit position
                 instead of something you have to nudge onto. -->
            <Style x:Key="PurpleSliderStyle" TargetType="Slider">
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="TickFrequency" Value="25"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                <Setter Property="SmallChange" Value="25"/>
                <Setter Property="LargeChange" Value="25"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6" CornerRadius="3" Background="#33909CA2" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track">
                                    <!-- The filled part to the left of the knob -->
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Focusable="False" IsTabStop="False" OverridesDefaultStyle="True">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" CornerRadius="3" Background="#F2AD0A" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <!-- Transparent so the dark track behind shows through -->
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Focusable="False" IsTabStop="False" OverridesDefaultStyle="True">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="16" Focusable="False" OverridesDefaultStyle="True"
                                               MouseEnter="SliderThumb_PlayHoverSound">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse x:Name="knob" Fill="#FFFFFF"/>
                                                    <ControlTemplate.Triggers>
                                                        <!-- White grab at rest, gold while hovered or dragged, like the buttons -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="knob" Property="Fill" Value="#F2AD0A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="knob" Property="Fill" Value="#F2AD0A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Button style (base; windows add EventSetter for hover sound) -->
            <Style x:Key="PurpleButtonStyleBase" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <!-- Auric's gold (the logo's frame) at rest. Hover turns the button inside out:
                     black face, gold text, and a 4 px gold outline drawn as a separate layer
                     over the face, so nothing is laid out differently between the states and
                     no seam shows where a border would meet its background. The press darkens
                     the gold and presses the button in. Feedback on the press itself. -->
                <Setter Property="Background" Value="#F2AD0A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="face"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="3.5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="outline"
                                        BorderBrush="#F2AD0A" BorderThickness="4" CornerRadius="3.5"
                                        Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="#000000"/>
                                    <Setter TargetName="outline" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="#000000"/>
                                    <Setter TargetName="outline" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="outline" Property="BorderBrush" Value="#D9980A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="face" Property="Background" Value="#33909CA2"/>
                                    <Setter TargetName="outline" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="outline" Property="BorderBrush" Value="#788287"/>
                                    <Setter TargetName="outline" Property="BorderThickness" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#F2AD0A"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="#D9980A"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#999999"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Purple button with hover/click sounds. Use this one for buttons; the Base
                 style above is only for cases that need styling without the sounds.
                 The click sound is on the tunnelling press, not on Click. Two reasons, and
                 the first is a correctness one: handlers on a routed event run in the order
                 they were registered, and a style's EventSetter is registered when the
                 Style attribute is set - so whether the sound came before or after a
                 button's own handler depended on which attribute the markup happened to
                 list first. LAUNCH GAME listed Click first and went silent until all its
                 checks had finished. A preview event runs ahead of every bubbling handler
                 whatever the order. The second is that a press is when the user expects to
                 hear it, rather than on release. -->
            <Style x:Key="PurpleButtonStyle" BasedOn="{StaticResource PurpleButtonStyleBase}" TargetType="Button">
                <EventSetter Event="MouseEnter" Handler="Button_PlayHoverSound"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Button_PlayClickSound"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>