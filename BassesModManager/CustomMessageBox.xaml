<Window x:Class="BassesModManager.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BassesModManager"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="400"
        MinWidth="320"
        MinHeight="200"
        MaxWidth="500"
        Background="Black"
        Title="Error">
    <Grid>
    <StackPanel Margin="24">
        <TextBlock x:Name="MessageText" Foreground="White" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,24"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- No local Background/Foreground here: local values outrank style triggers in
                 WPF, which is what previously stopped the hover effect from showing.
                 No fixed Height either - the shared style has padding, so a locked height
                 clips the label. MinWidth keeps them evenly sized. -->
            <Button x:Name="OkButton" Content="OK" MinWidth="90" FontSize="15"
                    Margin="0,0,12,0" Click="Ok_Click"
                    Style="{StaticResource PurpleButtonStyle}"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" FontSize="15"
                    Visibility="Collapsed" Click="Cancel_Click"
                    Style="{StaticResource PurpleButtonStyle}"/>
        </StackPanel>
    </StackPanel>
    <local:CustomCursorOverlay/>
    </Grid>
</Window>