<Window x:Class="BassesModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BassesModManager.Converters"
        xmlns:local="clr-namespace:BassesModManager"
        Title="Axon" Height="585" Width="936" MinHeight="535" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        FontSize="15">
    <Grid>
    <Grid Margin="20">
        <Grid.Resources>
            <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <!-- Tooltip style -->
            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#222"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <!-- First-run screen: one row per copy of the game found. A dark rounded row
                 that lights its border purple on hover and when it is the chosen one. -->
            <Style x:Key="CandidateRowStyle" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Feedback on the press itself, not on release: the row gives
                                 a little under the pointer -->
                            <Border x:Name="row" Background="#141414" BorderBrush="#262626" BorderThickness="1"
                                    CornerRadius="8" Padding="16,12" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="BorderBrush" Value="#555"/>
                                    <Setter TargetName="row" Property="Background" Value="#1A1A1A"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                    <Setter TargetName="row" Property="BorderBrush" Value="#8000FF"/>
                                </DataTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="row" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="MouseEnter" Handler="PlayHoverSound"/>
            </Style>

            <!-- The quiet second choice under a primary button: plain grey text that turns
                 white on hover, no box. -->
            <Style x:Key="LinkButtonStyle" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#888"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" TextDecorations="Underline"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="MouseEnter" Handler="PlayHoverSound"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Settings view: one row is name + explanation on the left, control on the right -->
            <Style x:Key="SettingNameStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <!-- One segment of a multi-option switch, built to match SettingToggle: same
                 track colour, same 3px inset on the filled part, same purple and the same
                 dimmed label when inactive. The difference is only that there are more than
                 two of them, so the "thumb" is whichever segment is chosen. -->
            <Style x:Key="ModVariantSegmentStyle" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="fill" CornerRadius="5" Margin="3" Background="Transparent">
                                <TextBlock x:Name="label"
                                           Text="{Binding Label}"
                                           Foreground="#888888" FontWeight="Bold" FontSize="13"
                                           Padding="12,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="label" Property="Foreground" Value="White"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="fill" Property="Background" Value="#8000FF"/>
                                    <Setter TargetName="label" Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="label" Property="Foreground" Value="#555555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="MouseEnter" Handler="PlayHoverSound"/>
            </Style>
            <Style x:Key="SettingHintStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#888"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
            </Style>
            <!-- Themed scrollbar for the mod list: a purple, rounded thumb instead of the
                 default Windows chrome. RepeatButtons are given an invisible template since
                 clicking the track above/below the thumb should still page-scroll. -->
            <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Rectangle Fill="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="thumbFill" Background="#8000FF" CornerRadius="4" Margin="4,0"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="thumbFill" Property="Background" Value="#9B33FF"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="thumbFill" Property="Background" Value="#6600CC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Border Margin="4,0" CornerRadius="4" Background="#1A1A1A"/>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <!-- Three views share this window: the mod list, the settings page and the game
             folder screen. Swapping their visibility rather than opening a second window
             means coming back is instant - the old separate windows rebuilt MainWindow
             from scratch, which re-ran the whole mod verification every time. The version
             label and the update bar sit outside all three, so they never move. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- 0: Active view -->
            <RowDefinition Height="Auto"/>  <!-- 1: Version label -->
            <RowDefinition Height="Auto"/>  <!-- 2: Update notification bar -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="MainView">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Heading, mode switch, settings -->
            <RowDefinition Height="*"/>     <!-- 1: Mod list -->
            <RowDefinition Height="Auto"/>  <!-- 2: Launch button -->
        </Grid.RowDefinitions>

        <!-- Top bar: heading on the left, settings on the right, placed by alignment in
             the same cell. -->
        <Grid Grid.Row="0">
            <TextBlock Text="SELECT MODS"
                       Style="{StaticResource HeadingTextStyle}"
                       FontSize="22"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <Button x:Name="SettingsButton"
                    Padding="8,0" Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="SettingsButton_Click"
                    Style="{StaticResource PurpleButtonStyle}"
                    ToolTip="Settings">
                <Viewbox Width="21" Height="21">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource GearIcon}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <!-- The mod list, every catalogued mod verification could back up. Rows are
             uniform: icon, name and description, then either a download offer or the
             control. IsSharedSizeScope keeps the text column the same width down the whole
             list, so the controls line up in a column without being pushed out to the far
             edge of the window. -->
        <ScrollViewer x:Name="ModListScrollViewer" Grid.Row="1" Margin="0,38,0,28" VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False" PreviewMouseWheel="ModListScrollViewer_PreviewMouseWheel"
                      Grid.IsSharedSizeScope="True">
            <ItemsControl x:Name="ModListControl" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ModText"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sized to match the name+description stack's natural height
                                 (13px bold + 12px line, 2px apart) rather than a round number,
                                 so the icon's bottom lines up with the description's instead of
                                 the text spilling past a smaller icon. -->
                            <Border Grid.Column="0" Width="34" Height="34" Margin="0,0,14,0"
                                    CornerRadius="6" VerticalAlignment="Center">
                                <!-- Clipped to the border's own rounding so the crosshair
                                     shots get the same soft corners as the app icon -->
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,34,34" RadiusX="6" RadiusY="6"/>
                                </Border.Clip>
                                <Grid>
                                    <!-- Mods with no artwork of their own get the app icon.
                                         A 256px PNG rather than the .ico: WPF picks one of
                                         the icon's frames and lands on a small one, which
                                         looked rough at any size.
                                         Loaded through the converter like every other image
                                         here. A plain relative Source would be read as a
                                         pack URI and looked for *inside* the assembly, and
                                         these are files copied next to the exe, not
                                         embedded resources - so it would silently find
                                         nothing and leave the icon blank. -->
                                    <Image Source="{Binding Source='Assets/Images/axon_logo.png', Converter={StaticResource StringToImageSourceConverter}}"
                                           Width="34" Height="34"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasCustomIcon, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"/>
                                    <!-- Crosshair shots are 150x150 game captures where the
                                         crosshair itself is a small thing in the middle.
                                         Drawn at half size inside a 34px window, the visible
                                         area is the centre 73px, which is the crosshair and
                                         not much else. -->
                                    <Image Source="{Binding ImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                           Width="73" Height="73"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasCustomIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- Wide enough that none of the catalog's current descriptions
                                 wrap to a second line - the longest ("Makes the scoreboard
                                 background black to improve readability") needs about this
                                 much room at 12px. Widening this pushes the status text and
                                 switch right for free, since they're Auto columns after it. -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0" MaxWidth="440">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Description}" Foreground="#888" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding StatusText}"
                                       Foreground="#888" FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <!-- Not downloaded yet means nothing to switch on, so the row
                                 offers the download instead of the control until it is here -->
                            <Button Grid.Column="3"
                                    Content="DOWNLOAD"
                                    Height="22" Padding="10,0" FontSize="11"
                                    VerticalAlignment="Center"
                                    Click="DownloadMod_Click"
                                    Style="{StaticResource PurpleButtonStyle}"
                                    Visibility="{Binding ShowDownloadButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Plain on/off mods get the wordless switch: shorter than the
                                 row and centred in it, with the same corners as everything
                                 else. Compact rather than the labelled shape because a
                                 column of ON/OFF pairs down the list was mostly width spent
                                 repeating what the knob position already says. -->
                            <local:SettingToggle Grid.Column="3"
                                                 Compact="True"
                                                 IsOn="{Binding IsEnabled}"
                                                 IsEnabled="{Binding IsAvailable}"
                                                 VerticalAlignment="Center"
                                                 Toggled="ModSwitch_Toggled"
                                                 Visibility="{Binding ShowSwitch, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- ...and mods that come in versions get the same switch with
                                 one segment per version instead of two.
                                 34 rather than the switch's 28, because what has to match is
                                 the purple: the segment fill is inset by 3 on each side, so
                                 a 34 container puts it at exactly the 28 of the switch's
                                 purple track. That leaves 3px of grey standing proud on
                                 either side, which against a black window is next to
                                 invisible - and the alternative was two purples of visibly
                                 different height in the same column. -->
                            <Border Grid.Column="3"
                                    CornerRadius="5" Height="34" Background="#2A2A2A"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowVariants, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding Variants}"
                                              IsEnabled="{Binding IsAvailable}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ModVariantSegmentStyle}"
                                                    Click="ModVariant_Click"
                                                    IsEnabled="{Binding IsAvailable}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Action row. Just the launch: Auric rides along as the version.dll the app
             places in the game folder, so there is no second step after the game is up. -->
        <Grid Grid.Row="2">
            <!-- The only tooltip it ever has says why it is out of action, and RefreshLaunchButton
                 clears it again once it isn't. WPF suppresses tooltips on disabled controls
                 unless told otherwise, which is exactly backwards for this one. -->
            <Button x:Name="LaunchGameButton"
                    Content="LAUNCH GAME"
                    Click="LaunchGameButton_Click"
                    Style="{StaticResource PurpleButtonStyle}"
                    ToolTipService.ShowOnDisabled="True"/>
        </Grid>
        </Grid>

        <!-- Settings view -->
        <Grid Grid.Row="0" x:Name="SettingsView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0: back -->
                <RowDefinition Height="Auto"/>  <!-- 1: heading -->
                <RowDefinition Height="Auto"/>  <!-- 2: settings -->
                <RowDefinition Height="*"/>     <!-- 3: spacer -->
            </Grid.RowDefinitions>

            <!-- Same slot and height as the gear button it replaces, so nothing jumps -->
            <Button Grid.Row="0" x:Name="BackButton"
                    Content="BACK"
                    Padding="12,0" Height="34"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="BackButton_Click"
                    Style="{StaticResource PurpleButtonStyle}"/>

            <TextBlock Grid.Row="1"
                       Text="SETTINGS"
                       Style="{StaticResource HeadingTextStyle}"
                       FontSize="26"
                       Margin="0,20,0,0"/>

            <!-- Capped width so each switch stays visually tied to its label instead of
                 drifting to the far edge of the window -->
            <!-- IsSharedSizeScope + SharedSizeGroup below: each row is a separate Grid, so
                 without this, each one's Auto column sizes to only its own control's width
                 and the switches/buttons end up starting at different X positions instead of
                 lining up in a column. -->
            <StackPanel Grid.Row="2" MaxWidth="620" HorizontalAlignment="Left" Margin="0,22,0,0"
                        Grid.IsSharedSizeScope="True">
                <!-- Every row below this one carries the 22px gap as a top margin, so the
                     spacing does not change hands when the rows are reordered -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingControl"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Sound effects" Style="{StaticResource SettingNameStyle}"/>
                        <TextBlock Text="Volume of the hover and click sounds - 0 turns them off" Style="{StaticResource SettingHintStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Slider x:Name="SoundSlider"
                                Width="150"
                                VerticalAlignment="Center"
                                Style="{StaticResource PurpleSliderStyle}"
                                ValueChanged="SoundSlider_ValueChanged"/>
                        <!-- Fixed width so the track doesn't shift as the number changes -->
                        <TextBlock Width="42" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="White" FontSize="13"
                                   TextAlignment="Right"
                                   Text="{Binding Value, ElementName=SoundSlider, StringFormat={}{0:0}%}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingControl"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Game executable" Style="{StaticResource SettingNameStyle}"/>
                        <TextBlock x:Name="GamePathText" Style="{StaticResource SettingHintStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="ChangeGameButton" Content="CHANGE"
                            HorizontalAlignment="Left"
                            Height="34" Padding="16,0"
                            Style="{StaticResource PurpleButtonStyle}"
                            Click="ChangeGameButton_Click"/>
                </Grid>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingControl"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Show app after the game closes" Style="{StaticResource SettingNameStyle}"/>
                        <TextBlock Text="Off keeps the app minimized when you quit the game" Style="{StaticResource SettingHintStyle}"/>
                    </StackPanel>
                    <!-- Same wordless switch as the mod list, but at 34 so it stands the
                         same height as the CHANGE and OPEN buttons in this column -->
                    <local:SettingToggle x:Name="RestoreToggle" Grid.Column="1"
                                         Compact="True" CompactHeight="34"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Toggled="RestoreToggle_Toggled"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- First-run screen. Shown only while no valid game folder is saved; once past
             it there is no way back (the settings page changes a working path). The app
             looks for the game itself, shows what it found as rows, and one click on
             CONTINUE is the whole set-up. A card in the middle of the window rather than
             a list with buttons in the corner. -->
        <Grid Grid.Row="0" x:Name="GameSelectView" Visibility="Collapsed">
            <!-- One column on the plain window background, nothing boxed in. Spacing on an
                 8 px scale (8/16/24/32), one primary action, the rest quiet. -->
            <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- The game's cover art (a stormtrooper visor with the battle in it), shown
                     whole: a small square, never a cropped strip -->
                <Border Width="96" Height="96" CornerRadius="12" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Image Source="Assets/Images/swbf.png" Stretch="UniformToFill"/>
                </Border>

                <TextBlock x:Name="SetupHeading"
                           Foreground="White" FontSize="26" FontWeight="SemiBold"
                           LineHeight="30" LineStackingStrategy="BlockLineHeight"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="SetupHint"
                           Foreground="#9A9A9A" FontSize="14"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="440" Margin="0,8,0,32"/>

                <!-- One row per copy found; a click makes it the chosen one -->
                <ItemsControl x:Name="CandidateList" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CandidateRowStyle}" Tag="{Binding}" Click="Candidate_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Path}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Source}" Foreground="#9A9A9A" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#x2713;" Foreground="#8000FF" FontSize="18" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="16,0,0,0"
                                               Visibility="{Binding IsChosen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Exactly one primary button at a time: CONTINUE when there is a folder
                     to continue with, CHOOSE FOLDER when there is not -->
                <Button x:Name="ContinueButton" Content="CONTINUE"
                        Style="{StaticResource PurpleButtonStyle}"
                        HorizontalAlignment="Center" Width="240" Height="44"
                        Click="ContinueButton_Click"/>
                <Button x:Name="ChooseFolderButton" Content="CHOOSE FOLDER"
                        Style="{StaticResource PurpleButtonStyle}"
                        HorizontalAlignment="Center" Width="240" Height="44"
                        Click="ChooseFolderButton_Click"/>
                <Button x:Name="ChangeFolderLink" Content="Use a different folder"
                        Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,16,0,0"
                        Click="ChooseFolderButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Version label -->
        <TextBlock Grid.Row="1" Text="v1.8" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0"/>

        <!-- Update ready notification (hidden until UpdateService has a verified download) -->
        <local:UpdateNotificationBar Grid.Row="2" Margin="0,10,0,0"/>
    </Grid>
    <local:CustomCursorOverlay/>
    </Grid>
</Window>
