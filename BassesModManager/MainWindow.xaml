<Window x:Class="BassesModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BassesModManager.Converters"
        xmlns:local="clr-namespace:BassesModManager"
        Title="Axon" Height="585" Width="936" MinHeight="535" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        FontFamily="{StaticResource AppFont}"
        FontSize="15">
    <Grid>
    <!-- The background: a muted loop behind everything, filling the window. The black
         window background stays underneath as the fallback while it loads or if the
         file cannot be played. Started and looped from code (LoadedBehavior=Manual). -->
    <MediaElement x:Name="BackgroundVideo"
                  Stretch="UniformToFill"
                  LoadedBehavior="Manual" UnloadedBehavior="Manual"
                  IsMuted="True" Volume="0"
                  IsHitTestVisible="False" Focusable="False"
                  MediaEnded="BackgroundVideo_MediaEnded"
                  MediaFailed="BackgroundVideo_MediaFailed">
        <!-- The clip's black is not quite black (16,16,16 after compression); the shader
             pulls everything at or below that level down to true black, so the window
             reads as black with the droid on it rather than dark grey -->
        <MediaElement.Effect>
            <local:BlackLevelEffect Lift="0.07"/>
        </MediaElement.Effect>
    </MediaElement>
    <Grid Margin="50,50,50,30">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <!-- Text sits straight on the video now, so every line gets a soft dark halo:
                 the picture stays fully visible, the type stays as readable as on black -->
            <DropShadowEffect x:Key="TextShadow" ShadowDepth="0" BlurRadius="10" Color="Black" Opacity="1"/>
            <!-- A tab in the navigation bar: white, a thin gold line under the active page.
                 The line is drawn over the pill, outside its box, so showing it changes
                 no layout; the hover pill replaces it. -->
            <Style x:Key="NavTabStyle" TargetType="RadioButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Margin" Value="0,0,36,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <!-- Brandon Grotesque's line box at 20 px is 28.6 high with the capitals in rows 7 to 21;
                                 the negative margin trims the unused room above and below, so the pill hugs the letters -->
                            <Grid>
                            <Border x:Name="pill" CornerRadius="4" Padding="3,0" Background="Transparent">
                                <Grid Margin="0,-5,0,-5">
                                    <TextBlock x:Name="label" Text="{TemplateBinding Content}" FontSize="20" FontWeight="Bold"
                                               Foreground="White"
                                               Effect="{StaticResource TextShadow}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="underline" Height="3" CornerRadius="1.5" Background="#F2AD0A" VerticalAlignment="Bottom"
                                    Margin="3,0,3,-4" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="underline" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="#F2AD0A"/>
                                    <Setter TargetName="label" Property="Foreground" Value="Black"/>
                                    <Setter TargetName="label" Property="Effect" Value="{x:Null}"/>
                                    <Setter TargetName="underline" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="MouseEnter" Handler="PlayHoverSound"/>
            </Style>
            <!-- Tooltip style -->
            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#000000"/>
                <Setter Property="BorderBrush" Value="#788287"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <!-- First-run screen: one row per copy of the game found. A dark rounded row
                 that lights its border purple on hover and when it is the chosen one. -->
            <Style x:Key="CandidateRowStyle" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Feedback on the press itself, not on release: the row gives
                                 a little under the pointer -->
                            <Border x:Name="row" Background="#000000" BorderBrush="#788287" BorderThickness="1"
                                    CornerRadius="6" Padding="16,12" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="BorderBrush" Value="#F2AD0A"/>
                                    <Setter TargetName="row" Property="Background" Value="#33909CA2"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                    <Setter TargetName="row" Property="BorderBrush" Value="#F2AD0A"/>
                                </DataTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="row" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="MouseEnter" Handler="PlayHoverSound"/>
            </Style>

            <!-- The quiet second choice under a primary button: plain grey text that turns
                 white on hover, no box. -->
            <Style x:Key="LinkButtonStyle" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#999999"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" TextDecorations="Underline"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="MouseEnter" Handler="PlayHoverSound"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Settings view: one row is name + explanation on the left, control on the right -->
            <Style x:Key="SettingNameStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Effect" Value="{StaticResource TextShadow}"/>
            </Style>
            <Style x:Key="SettingHintStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#999999"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="Effect" Value="{StaticResource TextShadow}"/>
            </Style>
            <!-- Themed scrollbar for the mod list: a purple, rounded thumb instead of the
                 default Windows chrome. RepeatButtons are given an invisible template since
                 clicking the track above/below the thumb should still page-scroll. -->
            <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Rectangle Fill="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="thumbFill" Background="#D9D9D9" CornerRadius="4" Margin="4,0"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="thumbFill" Property="Background" Value="#F2AD0A"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="thumbFill" Property="Background" Value="#F2AD0A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Border Margin="4,0" CornerRadius="4" Background="Transparent"/>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <!-- Three views share this window: the mod list, the settings page and the game
             folder screen. Swapping their visibility rather than opening a second window
             means coming back is instant - the old separate windows rebuilt MainWindow
             from scratch, which re-ran the whole mod verification every time. The update
             bar sits outside all three, so it never moves. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Navigation bar -->
            <RowDefinition Height="*"/>     <!-- 1: Active view -->
            <RowDefinition Height="Auto"/>  <!-- 2: Update notification bar -->
        </Grid.RowDefinitions>

        <!-- The game's own navigation bar, as the website recreates it: plain capitals, the
             active page underlined in gold, a gold pill under the pointer. Pulled left by the pill's own
             padding so the letters, not the pill, sit on the margin. Hidden on the first-run
             screen, where there is nothing to navigate to yet. -->
        <StackPanel Grid.Row="0" x:Name="NavBar" Orientation="Horizontal" Margin="-3,0,0,28">
            <RadioButton x:Name="NavPlay" Content="PLAY" GroupName="Nav"
                         Style="{StaticResource NavTabStyle}" Checked="NavPlay_Checked"/>
            <RadioButton x:Name="NavSettings" Content="SETTINGS" GroupName="Nav"
                         Style="{StaticResource NavTabStyle}" Checked="NavSettings_Checked"/>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="MainView">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- 0: Mod list -->
            <RowDefinition Height="Auto"/>  <!-- 1: Launch button -->
        </Grid.RowDefinitions>

        <!-- The mod list, every catalogued mod verification could back up. Rows are
             uniform: icon, name and description, then either a download offer or the
             control. IsSharedSizeScope keeps the text column the same width down the whole
             list, so the controls line up in a column without being pushed out to the far
             edge of the window. -->
        <ScrollViewer x:Name="ModListScrollViewer" Grid.Row="0" Margin="0,0,0,20" VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Grid.IsSharedSizeScope="True">
            <!-- One panel with every mod, rows parted by a hairline, no frame. A dark tint so the
                 video shows through dimmed, and only as wide as its widest row: the text column
                 is shared across rows, so every control starts right after the longest text and
                 the rest of the window shows the video in full. Pulled 14 px
                 into the margin so the text, not the tint, lines up with the navigation bar. -->
            <Border Background="#B3000000" CornerRadius="6" ClipToBounds="True" Margin="-14,0,8,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
            <ItemsControl x:Name="ModListControl" Margin="0,0,0,-1">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#33788287" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ModText"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Wide enough that none of the catalog's current descriptions
                                 wrap to a second line - the longest ("Makes the scoreboard
                                 background black to improve readability") needs about this
                                 much room at 12px. Widening this pushes the status text and
                                 switch right for free, since they're Auto columns after it. -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,20,0" MaxWidth="440">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="Bold" Effect="{StaticResource TextShadow}"/>
                                <TextBlock Text="{Binding Description}" Foreground="#999999" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,2,0,0" Effect="{StaticResource TextShadow}"/>
                            </StackPanel>

                            <!-- Plain on/off mods get the wordless switch: shorter than the
                                 row and centred in it, with the same corners as everything
                                 else. Compact rather than the labelled shape because a
                                 column of ON/OFF pairs down the list was mostly width spent
                                 repeating what the knob position already says. -->
                            <local:SettingToggle Grid.Column="1"
                                                 Compact="True"
                                                 IsOn="{Binding IsEnabled}"
                                                 IsEnabled="{Binding IsAvailable}"
                                                 VerticalAlignment="Center"
                                                 Toggled="ModSwitch_Toggled"/>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Border>
        </ScrollViewer>

        <!-- Action bar, always in the same place under the list: what is selected and the
             version on the left, stacked to the height of the one primary action on the
             right, so the bar is no taller than the button. Just the launch: Auric rides along
             as the version.dll the app places in the game folder, so there is no second
             step after the game is up. -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#66788287"/>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <TextBlock x:Name="LaunchStatusText"
                           Foreground="#999999" FontSize="13"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Effect="{StaticResource TextShadow}"/>
                <TextBlock Text="v1.9" FontSize="14" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                           Effect="{StaticResource TextShadow}"/>
                <Button x:Name="LaunchGameButton"
                        Content="LAUNCH GAME"
                        Width="200" Height="44"
                        HorizontalAlignment="Right"
                        Click="LaunchGameButton_Click"
                        Style="{StaticResource PurpleButtonStyle}"/>
            </Grid>
        </Grid>
        </Grid>

        <!-- Settings view -->
        <Grid Grid.Row="1" x:Name="SettingsView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0: settings -->
                <RowDefinition Height="*"/>     <!-- 1: spacer -->
            </Grid.RowDefinitions>

            <!-- The same tinted panel as the mod list, rows parted by a hairline, each one
                 name + explanation on the left and the control on the right, at the mod
                 list's sizes. The panel bleeds 14 px into the margin so the text, not the
                 tint, lines up with the navigation bar. IsSharedSizeScope + SharedSizeGroup
                 below: each row is a separate Grid, so without this, each one's Auto column
                 sizes to only its own control's width and the switches/buttons end up
                 starting at different X positions instead of lining up in a column. -->
            <Border Grid.Row="0" Background="#B3000000" CornerRadius="6" ClipToBounds="True" Margin="-14,0,8,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Margin="0,0,0,-1" Grid.IsSharedSizeScope="True">
                <Border BorderBrush="#33788287" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingText"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingControl"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,20,0" MaxWidth="440">
                        <TextBlock Text="Sound effects" Style="{StaticResource SettingNameStyle}"/>
                        <TextBlock Text="Volume of the hover and click sounds - 0 turns them off" Style="{StaticResource SettingHintStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Slider x:Name="SoundSlider"
                                Width="150"
                                VerticalAlignment="Center"
                                Style="{StaticResource PurpleSliderStyle}"
                                ValueChanged="SoundSlider_ValueChanged"/>
                        <!-- Fixed width so the track doesn't shift as the number changes -->
                        <TextBlock Width="42" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="White" FontSize="13"
                                   TextAlignment="Right"
                                   Effect="{StaticResource TextShadow}"
                                   Text="{Binding Value, ElementName=SoundSlider, StringFormat={}{0:0}%}"/>
                    </StackPanel>
                </Grid>
                </Border>

                <Border BorderBrush="#33788287" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingText"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingControl"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,20,0" MaxWidth="440">
                        <TextBlock Text="Game executable" Style="{StaticResource SettingNameStyle}"/>
                        <TextBlock x:Name="GamePathText" Style="{StaticResource SettingHintStyle}"/>
                    </StackPanel>
                    <!-- As tall as the switch below, so the column reads as one -->
                    <Button Grid.Column="1" x:Name="ChangeGameButton" Content="CHANGE"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Height="28" Padding="12,0" FontSize="12"
                            Style="{StaticResource PurpleButtonStyle}"
                            Click="ChangeGameButton_Click"/>
                </Grid>
                </Border>

                <Border BorderBrush="#33788287" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingText"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingControl"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,20,0" MaxWidth="440">
                        <TextBlock Text="Show app after the game closes" Style="{StaticResource SettingNameStyle}"/>
                        <TextBlock Text="Off keeps the app minimized when you quit the game" Style="{StaticResource SettingHintStyle}"/>
                    </StackPanel>
                    <!-- The same wordless switch as the mod list, at the same size -->
                    <local:SettingToggle x:Name="RestoreToggle" Grid.Column="1"
                                         Compact="True"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Toggled="RestoreToggle_Toggled"/>
                </Grid>
                </Border>
            </StackPanel>
            </Border>
        </Grid>

        <!-- First-run screen. Shown only while no valid game folder is saved; once past
             it there is no way back (the settings page changes a working path). The app
             looks for the game itself, shows what it found as rows, and one click on
             CONTINUE is the whole set-up. A card in the middle of the window rather than
             a list with buttons in the corner. -->
        <Grid Grid.Row="1" x:Name="GameSelectView" Visibility="Collapsed">
            <!-- One column on the plain window background, nothing boxed in. Spacing on an
                 8 px scale (8/16/24/32), one primary action, the rest quiet. -->
            <StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                <!-- The column settles into place once: a short fade with a few pixels of
                     rise, eased out, no bounce. One-off entrance, never on interaction. -->
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="SetupRise" Y="12"/>
                </StackPanel.RenderTransform>
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="SetupRise" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>

                <!-- No artwork, no display type: a small heading, one quiet line, the
                     folder, the button. The screen asks one thing and gets out of the way. -->
                <TextBlock x:Name="SetupHeading"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"
                           LineHeight="22" LineStackingStrategy="BlockLineHeight"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="SetupHint"
                           Foreground="#999999" FontSize="13"
                           LineHeight="18" LineStackingStrategy="BlockLineHeight"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="400" Margin="0,4,0,24"/>

                <!-- One row per copy found; a click makes it the chosen one -->
                <ItemsControl x:Name="CandidateList" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CandidateRowStyle}" Tag="{Binding}" Click="Candidate_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Path}" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Source}" Foreground="#999999" FontSize="11" Margin="0,2,0,0"
                                                   Typography.Capitals="AllSmallCaps"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#x2713;" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="16,0,0,0"
                                               Visibility="{Binding IsChosen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Exactly one primary button at a time: CONTINUE when there is a folder
                     to continue with, CHOOSE FOLDER when there is not -->
                <Button x:Name="ContinueButton" Content="CONTINUE"
                        Style="{StaticResource PurpleButtonStyle}"
                        HorizontalAlignment="Center" Width="200" Height="40"
                        Click="ContinueButton_Click"/>
                <Button x:Name="ChooseFolderButton" Content="CHOOSE FOLDER"
                        Style="{StaticResource PurpleButtonStyle}"
                        HorizontalAlignment="Center" Width="200" Height="40"
                        Click="ChooseFolderButton_Click"/>
                <Button x:Name="ChangeFolderLink" Content="Use a different folder"
                        Style="{StaticResource LinkButtonStyle}" FontSize="12"
                        HorizontalAlignment="Center" Margin="0,12,0,0"
                        Click="ChooseFolderButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Version label -->
        <!-- Update ready notification (hidden until UpdateService has a verified download) -->
        <local:UpdateNotificationBar Grid.Row="2" Margin="0,10,0,0"/>
    </Grid>
    </Grid>
</Window>
